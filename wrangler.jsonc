{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monroeresidential",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CONTACT_FROM": "Monroe Residential Partners <noreply@rs.monroeresidential.com>",
    "CONTACT_TO": "mike@monroeresidential.com"
  }
}
